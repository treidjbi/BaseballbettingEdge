    "adjusted_ev_low_max_exclusive": "0.06",
    "adjusted_ev_moderate_max_exclusive": "0.17",
    "no_vig_base_min": "0.02",
    "no_vig_reentry_min": "0.04",
    "preclose_strong_score_min": "5",
    "preclose_medium_score_min": "3"
