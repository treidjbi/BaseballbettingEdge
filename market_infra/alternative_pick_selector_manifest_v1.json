    "reentry_expansion": "reentry_support AND NOT no_drag"
  },
  "timing_and_freeze": {
    "timezone": "America/Phoenix",
    "provisional": "before operational lock",
    "freeze": "first valid due_now or missed_lock while pregame",
    "post_start": "never freeze or backfill"
  }
